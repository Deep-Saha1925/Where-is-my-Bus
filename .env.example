# Copy this file to ".env" (which is git-ignored) and fill in real values.
# Load it from your IDE's run configuration (e.g. IntelliJ EnvFile plugin) or export the
# variables in your shell. In production (Render) set the same names in the dashboard.
# NEVER put real values in this file -- it IS committed.

# ── Admin login (/login, /admin, /admin-buses) ──
# Use a long random password (12+ characters). The app warns at startup if it is weak.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ── PostgreSQL (e.g. Neon) ──
# JDBC form: jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://your-host.example.neon.tech/your_db?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ── Redis (e.g. Upstash) ──
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ── Optional ──
# Set to true in production to REFUSE to start with a weak/blank admin password
# (default false: only logs a warning).
ENFORCE_STRONG_ADMIN_PASSWORD=false

# ── CORS (development only) ──
# Leave empty in production (the pages are served by this same server).
# Example when using VS Code Live Server: http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=

# ── Driver login rate limiting (defaults shown) ──
# LOGIN_WINDOW_SECONDS=600
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_MAX_FAILURES_PER_IP=10
# LOGIN_MAX_FAILURES_PER_DEPOT=40
# LOGIN_MAX_FAILURES_PER_BUS=8
# Number of trusted proxies in front of the app (Render = 1, Render behind a CDN = 2)
# TRUSTED_PROXY_HOPS=1

# ── Ghost-ride handling (defaults shown) ──
# RIDE_STALE_AFTER_SECONDS=300       # no location this long -> hidden from passenger search
# RIDE_AUTO_END_AFTER_SECONDS=1800   # no location this long -> ride ended automatically
# RIDE_CLEANUP_INTERVAL_MS=60000     # how often the cleanup job runs

# ── Location history clean-up (defaults shown) ──
# LOCATION_RETENTION_DAYS=30     # 0 = never delete
# RETENTION_BATCH_SIZE=5000
# RETENTION_MAX_BATCHES=200
# RETENTION_CRON=0 30 3 * * *
# RETENTION_ZONE=Asia/Kolkata
